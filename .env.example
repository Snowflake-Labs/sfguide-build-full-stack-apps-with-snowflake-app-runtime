# Copy to .env after running scripts/grants.sql (the role must exist first):
#   cp .env.example .env
# Then load it: echo dotenv > .envrc && direnv allow
#   or, without direnv: set -a; source .env; set +a
#
# Use YOUR Snowflake CLI connection name. If it isn't "quickstart", change the
# value below and the QUICKSTART part of the role variable to match, e.g.
# SNOWFLAKE_CONNECTIONS_MYCONN_ROLE.
#
# Also set the connection's default role and warehouse in connections.toml:
#   role = "SFQUICKSTART_CHURNGUARD_ROLE"
#   warehouse = "SFQUICKSTART_CHURNGUARD_WH"
# `snow app deploy` uses the connection's default role; --role alone is not
# enough for every deploy step.
SNOWFLAKE_DEFAULT_CONNECTION_NAME=quickstart
SNOWFLAKE_CONNECTIONS_QUICKSTART_ROLE=SFQUICKSTART_CHURNGUARD_ROLE
SNOWFLAKE_CONNECTIONS_QUICKSTART_WAREHOUSE=SFQUICKSTART_CHURNGUARD_WH
