# About YOUR RUN: copy to .env.test (git-ignored) and edit:
#   cp tests/e2e/.env.test.example tests/e2e/.env.test
# Which guide URL to test, your connection, local paths. Facts about the guide itself
# (stages, roles, tools) live in harness.env, which is committed.
# Precedence: shell > .env.test > harness.env. CI ignores this file and uses the
# workflow inputs and the CI environment instead.

# Required: the guide the agent follows. Use the published guide, or a preview
# URL to test unpublished changes.
GUIDE_URL=

# Optional: the guide's markdown source, so the flow, order and consistency
# reviews cite guide.md:<line>. A path (absolute, or relative to this repo's
# root), a file:// URL, or an https:// raw URL. Use the source that matches GUIDE_URL.
# GUIDE_MD=../sfquickstarts/site/sfguides/src/build-full-stack-apps-with-snowflake-app-runtime/build-full-stack-apps-with-snowflake-app-runtime.md

# Optional (defaults shown)
# SNOWFLAKE_CONNECTION=quickstart
# REPO_URL=https://github.com/Snowflake-Labs/sfguide-build-full-stack-apps-with-snowflake-app-runtime.git
# RUN_DIR=/tmp/churnguard-e2e
# MAX_TURNS=80
# MAX_ATTEMPTS=3
