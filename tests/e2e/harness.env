# About the GUIDE (committed, the same for everyone and CI): its stages, title, tools,
# companion repo and roles. Change it when the guide changes.
# About YOUR RUN (git-ignored): .env.test, from .env.test.example. Which guide URL to
# test, your connection, local paths. Precedence: shell > .env.test > this file.

# Guide title used in the agent's goal.
GUIDE_TITLE="${GUIDE_TITLE:-Build Full-Stack Apps with Snowflake App Runtime}"
# Stages in order; each must have a "## STAGE: <name>" section in stages.md.
STAGES="${STAGES:-setup iteration-1 iteration-2 iteration-3}"
# Learner workspace repo (cloned into RUN_DIR).
DEFAULT_REPO_URL="https://github.com/Snowflake-Labs/sfguide-build-full-stack-apps-with-snowflake-app-runtime.git"
# Default RUN_DIR is ${TMPDIR:-/tmp}/<RUN_NAME>.
RUN_NAME="${RUN_NAME:-churnguard-e2e}"
# Tools the guide needs, checked before each stage.
REQUIRED_TOOLS="${REQUIRED_TOOLS:-cortex snow git node npm psql envsubst curl}"
# Role and warehouse the connection must default to after the first stage (leave
# QS_ROLE empty to skip the check). ci-hook.sh sets them after the first stage.
QS_ROLE="${QS_ROLE:-SFQUICKSTART_CHURNGUARD_ROLE}"
QS_WAREHOUSE="${QS_WAREHOUSE:-SFQUICKSTART_CHURNGUARD_WH}"
